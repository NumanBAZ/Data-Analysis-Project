{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rakip Analizi",
  "version": "0.1.2",
  "identifier": "com.benasse.admin-orijinal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "pnpm dev --port 5177 --strictPort",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rakip Analizi",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Turkish"
        ],
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMjAwRkZBRDI3NjJDNkYKUldSdkxIYlMrZzhncXdwalFDVWJOYmJLN25nNjFQSU13SkRQdDYyY1NteWpKNkJFZ0xib3BxNHcK",
      "endpoints": [
        "https://github.com/NumanBAZ/Data-Analysis-Project/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
